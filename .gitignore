# Kundendaten. Anfragen enthalten Namen, Adressen und Telefonnummern echter
# Personen - die gehoeren nicht ins Repository, auch nicht in ein privates.
automation/work/

# Anhaenge aus Kundenanfragen (Objektlisten, Lageplaene, Flurkarten).
# Gehoeren nach automation/work/, landen aber erfahrungsgemaess zuerst hier.
*.xlsx
*.xls
*.docx
*.pdf
# Auch die Handmessungen: sie tragen die Adressen der Kundenobjekte.
*.csv
!automation/samples/*.csv
# Aufmassblaetter und andere Archive aus Kundenanfragen
*.zip

# Aus dem gebauten Tool entnommen, jederzeit reproduzierbar:
#   node cv/extract-vendor.js ../Aufmass_2026-08-21.html
automation/vendor/

# Zwischenprodukte des Luftbild-Schritts
__pycache__/
*.dop.png
*.debug.png
*.bbox
!automation/cv/samples/*.png

node_modules/
.DS_Store
